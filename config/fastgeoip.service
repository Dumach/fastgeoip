# /etc/systemd/system/fastpostal.service
# Systemd service file for Uvicorn with Gunicorn

[Unit]
Description=FastGeoIp Service with Uvicorn
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=fastapi
Group=fastapi
WorkingDirectory=/opt/fastgeoip

# Run uvicorn workers via the project console script
ExecStart=/opt/fastgeoip/.venv/bin/serve

# Graceful reload
ExecReload=/bin/kill -s HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5

# Log directory
LogsDirectory=fastgeoip
LogsDirectoryMode=0750

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# Resource limits
LimitNOFILE=65535
LimitNPROC=65535

[Install]
WantedBy=multi-user.target
