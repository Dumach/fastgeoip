# Copy this file to .env and adjust. Real environment variables take precedence over .env.

# DEV (reload, 1 worker, auth bypassed) | DEBUG (debug logs) | PROD (default, (cpu_count*2)+1 workers)
ENVIRONMENT = PROD

HOST = 0.0.0.0
PORT = 8080

# Comma-separated list of accepted X-API-KEY values.
# Required in PROD/DEBUG — the server refuses to start without it (fail fast).
ACCESS_KEY =

# TLS certificate and key paths (used together, leave empty for plain HTTP)
SSL_CERT =
SSL_KEY =

# Directory for the rotating access.log (1 MB x 5)
LOG_PATH = ./logs

# GeoLite2-City database location (default shown)
DB_PATH = ./db/GeoLite2-City.mmdb

# Peers uvicorn trusts for X-Forwarded-For rewriting.
# Keep the default unless your reverse proxy lives on another host/network.
FORWARDED_ALLOW_IPS = 127.0.0.1,::1
