# Copy this file to .env and adjust. Real environment variables take precedence over .env.

# DEV (reload, 1 worker, auth bypassed) | DEBUG (debug logs) | PROD (default, (cpu_count*2)+1 workers)
ENVIRONMENT = PROD

HOST = 0.0.0.0
PORT = 8080

# Comma-separated list of accepted X-API-KEY values.
# Empty in PROD/DEBUG means every request returns 403.
ACCESS_KEY =

# TLS certificate and key paths (used together, leave empty for plain HTTP)
SSL_CERT =
SSL_KEY =

# Directory for the rotating access.log (1 MB x 5)
LOG_PATH = ./logs
